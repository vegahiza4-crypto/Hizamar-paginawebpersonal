/* RESET */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f4f4f4;
}

/* HEADER */
header{
    background:#2c3e50;
    color:white;
    padding:20px;
}

.contenedor-logo{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:20px;
    margin-bottom:20px;
}

.logo{
    width:120px;
    height:120px;
    object-fit:contain;
    background:white;
    padding:5px;
    border-radius:10px;
}

.eslogan{
    color:#ddd;
    font-style:italic;
}

/* BOTONES INFO */
.botones-info{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:15px;
    margin:20px 0;
}

.botones-info button{
    padding:12px 25px;
    border:none;
    background:#f1c40f;
    color:#2c3e50;
    font-weight:bold;
    border-radius:8px;
    cursor:pointer;
    transition:.3s;
}

.botones-info button:hover{
    background:#f39c12;
}

.info-contenido{
    background:white;
    color:#333;
    max-width:900px;
    margin:auto;
    padding:20px;
    border-radius:12px;
    text-align:center;
    box-shadow:0 2px 10px rgba(0,0,0,.2);
}

/* CARRUSEL */
.carrusel-principal{
    position:relative;
    width:90%;
    max-width:900px;
    height:450px;
    margin:30px auto;
    overflow:hidden;
    border-radius:15px;
}

.imagen-slide{
    position:absolute;
    width:100%;
    height:100%;
    opacity:0;
    transition:1s;
}

.imagen-slide img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.imagen-slide.activo{
    opacity:1;
}

.indicadores{
    position:absolute;
    bottom:15px;
    left:50%;
    transform:translateX(-50%);
}

.dot{
    width:12px;
    height:12px;
    background:white;
    border-radius:50%;
    display:inline-block;
    margin:4px;
}

.dot.activo{
    background:#f1c40f;
}

/* MENU */
.menu{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:15px;
    padding:25px;
}

.menu button{
    padding:12px 20px;
    border:none;
    background:#2c3e50;
    color:white;
    border-radius:8px;
    cursor:pointer;
}

/* CONTENIDO */
#contenido{
    width:85%;
    margin:auto;
    background:white;
    padding:25px;
    border-radius:12px;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
}

/* TABLA */
.tabla-libros{
    width:100%;
    border-collapse:collapse;
    margin-top:20px;
}

.tabla-libros th{
    background:#2c3e50;
    color:white;
    padding:12px;
}

.tabla-libros td{
    border:1px solid #ddd;
    padding:10px;
    text-align:center;
}

.tabla-libros tr:nth-child(even){
    background:#f2f2f2;
}

/* IMAGEN LIBRO */
.img-libro{
    width:60px;
    height:85px;
    object-fit:cover;
    cursor:pointer;
    border-radius:6px;
    transition:0.3s;
}

.img-libro:hover{
    transform:scale(1.1);
}

/* MODAL IMAGEN */
#modal-img{
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.85);
    justify-content:center;
    align-items:center;
    z-index:99999;
}

#modal-img img{
    max-width:80%;
    max-height:80%;
    border-radius:10px;
    box-shadow:0 0 20px black;
    cursor:pointer;
}

/* BUSQUEDA */
.busqueda{
    text-align:center;
    margin-top:20px;
}

.busqueda input{
    width:300px;
    padding:10px;
    border:1px solid #ccc;
    border-radius:5px;
}

.busqueda button{
    padding:10px 15px;
    border:none;
    background:#2c3e50;
    color:white;
    border-radius:5px;
    cursor:pointer;
}

.busqueda button:hover{
    background:#34495e;
}

/* FOOTER */
footer{
    background:#2c3e50;
    color:white;
    text-align:center;
    padding:30px;
    margin-top:40px;
}

.redes a{
    color:white;
    font-size:35px;
    margin:0 15px;
}

.redes a:hover{
    color:#f1c40f;
}